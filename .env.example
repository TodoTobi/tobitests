# TobiTests Environment Configuration Example
# Copy this file to .env and adjust values for your local target application.

# Target Frontend Web Application URL (used by Playwright E2E & @playwright/mcp)
TARGET_URL=http://localhost:3000

# Relative or absolute path to the target repository for White-Box route & schema discovery
TARGET_REPO_PATH=../my-app

# Base URL for Pure Backend / REST API contract & fuzzing suites ({ request } fixture)
API_BASE_URL=http://localhost:3000

# Chrome DevTools Protocol (CDP) remote debugging port for @chromedevtools/chrome-devtools-mcp
CDP_PORT=9222

# Default Audit Scope: frontend | backend | fullstack
AUDIT_SCOPE=fullstack
