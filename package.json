{
  "name": "tobitests",
  "version": "1.0.0",
  "description": "Autonomous Multi-Agent E2E QA & Visual Office Telemetry Framework",
  "main": "index.js",
  "scripts": {
    "audit": "python scripts/tobitests_cli.py",
    "audit:init": "python scripts/tobitests_cli.py --status exploring --step 1",
    "audit:run": "python scripts/ingest_playwright_results.py --run-playwright",
    "dev:all": "npm run dev --prefix web",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "dev:web": "npm run dev --prefix web",
    "build:web": "npm run build --prefix web",
    "postinstall": "npm install --prefix web"
  },
  "keywords": [
    "testing",
    "e2e",
    "playwright",
    "mcp",
    "chrome-devtools",
    "agents",
    "qa",
    "automation",
    "observability"
  ],
  "author": "todotobi",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
